<UserControl x:Class="Invoice_Management_System.Activation.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Invoice_Management_System"
             xmlns:l="clr-namespace:Invoice_Management_System.Localization">
    <!-- Ανοίγει μέσα στο κύριο παράθυρο μέσω InAppDialog.ShowCustom (τίτλος/υπότιτλος στην επικεφαλίδα) -->
    <StackPanel>
        <TextBlock Text="{l:Tr Act_Label}" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="txtLicenseKey" Style="{StaticResource Input}" Height="48" Tag="XXXX-XXXX-XXXX-XXXX"
                 FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="SemiBold"
                 CharacterCasing="Upper" TextChanged="LicenseKey_TextChanged"/>
        <StackPanel x:Name="errorRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <local:Icon Data="{StaticResource Ico.AlertCircle}" Foreground="{StaticResource Red}" Width="15" Height="15" StrokeWidth="2.4" Margin="0,0,6,0"/>
            <TextBlock Text="{l:Tr Act_Invalid}" Foreground="{StaticResource Red}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="{l:Tr Act_Button}" MinWidth="140" Click="ActivateLicense_Click"/>
            <TextBlock VerticalAlignment="Center" FontSize="13">
                <Hyperlink NavigateUri="mailto:info@netronium.ch" RequestNavigate="Link_RequestNavigate"
                           Foreground="{StaticResource AccentInk}" TextDecorations="{x:Null}" FontWeight="SemiBold">
                    <Run Text="{l:Tr Act_NeedCode}"/>
                </Hyperlink>
            </TextBlock>
        </DockPanel>
    </StackPanel>
</UserControl>
