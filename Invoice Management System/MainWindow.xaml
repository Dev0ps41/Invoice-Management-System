<Window x:Class="Invoice_Management_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Invoice_Management_System"
        xmlns:l="clr-namespace:Invoice_Management_System.Localization"
        Title="Invoice Manager" Height="900" Width="1440" Icon="/icon-invoice.png"
        MinHeight="760" MinWidth="1240" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:InitialsConverter x:Key="Initials"/>
        <local:LowStockConverter x:Key="IsLow"/>
        <local:SupplierBrushConverter x:Key="SupplierBg" Part="Background"/>
        <local:SupplierBrushConverter x:Key="SupplierFg" Part="Foreground"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Background="{StaticResource Side}" Padding="16,24">
            <DockPanel LastChildFill="False">
                <!-- Λογότυπο -->
                <DockPanel DockPanel.Dock="Top" Margin="8,0,0,24">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Accent}">
                        <local:Icon Data="{StaticResource Ico.Receipt}" Foreground="White" Width="22" Height="22"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Invoice Manager" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr Brand_By}" Foreground="{StaticResource SideMuted}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="navProducts" Style="{StaticResource NavButtonActive}" Click="ShowAllProducts_Click" AutomationProperties.Name="{l:Tr Nav_Products}">
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Grid}" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:Tr Nav_Products}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OpenReports_Click" AutomationProperties.Name="{l:Tr Nav_Reports}">
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Chart}" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:Tr Nav_Reports}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="PrintInvoice_Click" AutomationProperties.Name="{l:Tr Nav_Print}">
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Printer}" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:Tr Nav_Print}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <TextBlock Text="{l:Tr Nav_SectionData}" Style="{StaticResource SideSection}"/>
                    <Button Style="{StaticResource NavButton}" Click="ImportCSV_Click" AutomationProperties.Name="{l:Tr Nav_ImportCsv}">
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Download}" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:Tr Nav_ImportCsv}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="ExportCSV_Click" AutomationProperties.Name="{l:Tr Nav_ExportCsv}">
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Upload}" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:Tr Nav_ExportCsv}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <TextBlock Text="{l:Tr Nav_SectionSystem}" Style="{StaticResource SideSection}"/>
                    <Button Style="{StaticResource NavButton}" Click="OpenContextMenu_Click" AutomationProperties.Name="{l:Tr Nav_Settings}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Tr Menu_DeleteDb}" Click="DeleteAllData_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Sliders}" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:Tr Nav_Settings}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="CheckForUpdates_Click" AutomationProperties.Name="{l:Tr Nav_Updates}">
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Refresh}" Margin="0,0,12,0"/>
                            <Border x:Name="updateBadge" DockPanel.Dock="Right" Background="{StaticResource Yellow}" CornerRadius="99"
                                    Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="{l:Tr Nav_NewBadge}" Foreground="{StaticResource Ink}" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{l:Tr Nav_Updates}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OpenContextMenu_Click" AutomationProperties.Name="{l:Tr Nav_About}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="activationStatusMenuItem" Header="{l:Tr Status_Activation}" Click="OpenActivationWindow"/>
                                <MenuItem Header="{l:Tr Menu_About}" Click="ShowInfo_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Info}" Margin="0,0,12,0"/>
                            <TextBlock Text="{l:Tr Nav_About}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>

                <!-- Κάρτα άδειας -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SideCard}" BorderBrush="{StaticResource SideLine}"
                        BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <local:Icon Data="{StaticResource Ico.Shield}" Foreground="{StaticResource GreenBright}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="txtLicenseTitle" Text="{l:Tr License_TrialActive}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="txtLicenseDays" Text="" Foreground="{StaticResource SideMuted}" FontSize="13" Margin="0,8,0,10"/>
                        <Grid Height="8">
                            <Border CornerRadius="4" Background="{StaticResource SideLine}"/>
                            <Border x:Name="licenseBar" CornerRadius="4" HorizontalAlignment="Left" Width="0" Background="{StaticResource GreenBright}"/>
                        </Grid>
                        <Button Style="{StaticResource BtnLink}" Foreground="#A5B4FC" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Click="OpenActivationWindow" AutomationProperties.Name="{l:Tr License_ActivateLink}">
                            <TextBlock Text="{l:Tr License_ActivateLink}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Column="1" Margin="40,28,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Margin="0,0,0,24">
                <TextBox x:Name="txtSearch" DockPanel.Dock="Right" Width="340" Style="{StaticResource SearchBox}"
                         Tag="{l:Tr Search_Placeholder}" ToolTip="{l:Tr Kbd_Search}" TextChanged="SearchProduct"/>

                <!-- Επιλογή γλώσσας -->
                <Border DockPanel.Dock="Right" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="12"
                        Padding="4" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <local:Icon Data="{StaticResource Ico.Globe}" Foreground="{StaticResource Ink3}" Width="16" Height="16" Margin="8,0,6,0"/>
                        <RadioButton x:Name="langEl" Style="{StaticResource LangButton}" Content="EL" Tag="el" Click="Language_Click" ToolTip="Ελληνικά"/>
                        <RadioButton x:Name="langEn" Style="{StaticResource LangButton}" Content="EN" Tag="en" Click="Language_Click" ToolTip="English" Margin="2,0"/>
                        <RadioButton x:Name="langDe" Style="{StaticResource LangButton}" Content="DE" Tag="de" Click="Language_Click" ToolTip="Deutsch"/>
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Nav_Products}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{l:Tr Header_Subtitle}" FontSize="15" Foreground="{StaticResource Ink2}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- KPI κάρτες -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.9*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource IconTile}" Background="{StaticResource AccentSoft}">
                                <local:Icon Data="{StaticResource Ico.Box}" Foreground="{StaticResource AccentInk}"/>
                            </Border>
                            <TextBlock Text="{l:Tr Kpi_Count}" Style="{StaticResource KpiLabel}"/>
                        </DockPanel>
                        <TextBlock x:Name="kpiCount" Text="0" Style="{StaticResource KpiValue}"/>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource GreenSoft}">
                            <TextBlock x:Name="kpiToday" Text="+0" Style="{StaticResource PillText}" Foreground="{StaticResource GreenInk}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource IconTile}" Background="{StaticResource SkySoft}">
                                <local:Icon Data="{StaticResource Ico.Euro}" Foreground="{StaticResource SkyInk}"/>
                            </Border>
                            <TextBlock Text="{l:Tr Kpi_Value}" Style="{StaticResource KpiLabel}"/>
                        </DockPanel>
                        <TextBlock x:Name="kpiValue" Text="€0" Style="{StaticResource KpiValue}"/>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource IndigoSoft}">
                            <TextBlock x:Name="kpiSuppliers" Text="0" Style="{StaticResource PillText}" Foreground="{StaticResource IndigoInk}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="8,0">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource IconTile}" Background="{StaticResource AmberSoft}">
                                <local:Icon Data="{StaticResource Ico.Alert}" Foreground="{StaticResource AmberIcon}"/>
                            </Border>
                            <TextBlock Text="{l:Tr Kpi_Low}" Style="{StaticResource KpiLabel}"/>
                        </DockPanel>
                        <TextBlock x:Name="kpiLow" Text="0" Style="{StaticResource KpiValue}"/>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}">
                            <TextBlock Text="{l:Tr Kpi_LowHint}" Style="{StaticResource PillText}" Foreground="{StaticResource AmberInk}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Donut: αξία ανά προμηθευτή -->
                <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <DockPanel>
                        <local:DonutChart x:Name="supplierDonut" Width="120" Height="120" Thickness="18" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="220" MaxWidth="340">
                            <TextBlock Text="{l:Tr Kpi_BySupplier}" Style="{StaticResource KpiLabel}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="donutLegend">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,10,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="Bold" FontSize="13.5"
                                                       Typography.NumeralAlignment="Tabular" Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Νέα καταχώρηση -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="22,20" Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border x:Name="saveStatusText" DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="12,4"
                                Background="{StaticResource GreenSoft}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource Ico.Check}" Foreground="{StaticResource GreenInk}" Width="14" Height="14" StrokeWidth="2.5" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:Tr Form_Saved}" Foreground="{StaticResource GreenInk}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:Tr Form_Title}" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="0.6*" MinWidth="96"/>
                            <ColumnDefinition Width="0.65*" MinWidth="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{l:Tr Field_Supplier}" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputShell}">
                                <ComboBox x:Name="txtSupplier" Style="{StaticResource FlatCombo}" ItemsSource="{Binding SupplierSuggestions}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="{l:Tr Field_Code}" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputShell}">
                                <ComboBox x:Name="txtProductCode" Style="{StaticResource FlatCombo}" ItemsSource="{Binding ProductCodeSuggestions}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                            <TextBlock Text="{l:Tr Field_Name}" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputShell}">
                                <ComboBox x:Name="txtName" Style="{StaticResource FlatCombo}" ItemsSource="{Binding ProductNameSuggestions}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,14,0">
                            <TextBlock Text="{l:Tr Field_Stock}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtStock" Style="{StaticResource Input}" Tag="0" TextAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,14,0">
                            <TextBlock Text="{l:Tr Field_Price}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtPrice" Style="{StaticResource Input}" Tag="{l:Tr Ph_Price}" TextAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource BtnSuccess}" Click="AddProduct_Click" IsDefault="True" AutomationProperties.Name="{l:Tr Btn_Add}">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource Ico.Plus}" Width="16" Height="16" StrokeWidth="2.5" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:Tr Btn_Add}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}" Margin="8,0,0,0" Click="UndoLastAction_Click" ToolTip="{l:Tr Tip_Undo}" AutomationProperties.Name="{l:Tr Tip_Undo}">
                                <local:Icon Data="{StaticResource Ico.Undo}"/>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}" Margin="8,0,0,0" Click="RedoLastAction_Click" ToolTip="{l:Tr Tip_Redo}" AutomationProperties.Name="{l:Tr Tip_Redo}">
                                <local:Icon Data="{StaticResource Ico.Redo}"/>
                            </Button>
                            <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="SaveAll_Click" AutomationProperties.Name="{l:Tr Btn_Save}">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource Ico.Check}" Width="16" Height="16" StrokeWidth="2.5" Margin="0,0,8,0"/>
                                    <TextBlock Text="{l:Tr Btn_Save}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Πίνακας -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="22,16">
                        <TextBlock x:Name="txtCount" DockPanel.Dock="Right" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr List_Title}" Style="{StaticResource SectionTitle}"/>
                        <Border Background="{StaticResource LineSoft}" CornerRadius="12" Padding="4" Margin="18,0,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="chipAll" Style="{StaticResource Chip}" Content="{l:Tr Chip_All}" IsChecked="True" Click="ShowAllProducts_Click"/>
                                <RadioButton Style="{StaticResource Chip}" Content="{l:Tr Chip_Today}" Click="ShowTodayProducts_Click" Margin="4,0,0,0"/>
                                <RadioButton Style="{StaticResource Chip}" Content="{l:Tr Chip_Yesterday}" Click="ShowYesterdayProducts_Click" Margin="4,0,0,0"/>
                                <RadioButton Style="{StaticResource Chip}" Click="ShowProductsByDate_Click" Margin="4,0,0,0" AutomationProperties.Name="{l:Tr Chip_Date}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource Ico.Calendar}" Width="15" Height="15" Margin="0,0,6,0"/>
                                        <TextBlock Text="{l:Tr Chip_Date}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Chip}" Content="{l:Tr Chip_Last}" Click="ShowLastProductDate_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!-- Σύνολο κάτω από τον πίνακα -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="22,12,22,16" LastChildFill="False">
                        <TextBlock x:Name="txtGridTotal" DockPanel.Dock="Right" FontSize="16" FontWeight="ExtraBold" Margin="16,0,90,0"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{l:Tr List_Total}" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid x:Name="productGrid" Style="{StaticResource ModernGrid}"
                              AutoGenerateColumns="False" SelectionMode="Single"
                              SelectionChanged="productGrid_SelectionChanged"
                              RowEditEnding="productGrid_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{l:Tr Col_Supplier}" Width="220" SortMemberPath="Supplier" HeaderStyle="{StaticResource FirstHeader}">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
                                        <Setter Property="Padding" Value="22,0,16,0"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0"
                                                    Background="{Binding Supplier, Converter={StaticResource SupplierBg}}">
                                                <TextBlock Text="{Binding Supplier, Converter={StaticResource Initials}}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding Supplier, Converter={StaticResource SupplierFg}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Supplier}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{l:Tr Col_Code}" Binding="{Binding ProductCode}" Width="130" ElementStyle="{StaticResource CodeCell}"/>
                            <DataGridTextColumn Header="{l:Tr Col_Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource NameCell}"/>

                            <DataGridTemplateColumn Header="{l:Tr Col_Stock}" Width="150" SortMemberPath="Stock" HeaderStyle="{StaticResource RightHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border x:Name="lowBadge" Style="{StaticResource Pill}" Background="{StaticResource AmberSoft}"
                                                    Padding="8,3,8,4" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                                                <TextBlock Text="{l:Tr Badge_Low}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AmberInk}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Stock, StringFormat={}{0:#,0.##}}" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Stock, Converter={StaticResource IsLow}}" Value="True">
                                                <Setter TargetName="lowBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{l:Tr Col_Price}" Binding="{Binding Price, StringFormat='€#,0.00'}" Width="110"
                                                ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource RightHeader}"/>
                            <DataGridTextColumn Header="{l:Tr Col_Total}" Binding="{Binding TotalValue, StringFormat='€#,0.00'}" Width="150"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource NumCellBold}" HeaderStyle="{StaticResource RightHeader}"/>

                            <DataGridTemplateColumn Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BtnDangerSoft}" HorizontalAlignment="Right"
                                                ToolTip="{l:Tr Tip_Delete}" Click="DeleteProduct_Click" AutomationProperties.Name="{l:Tr Tip_Delete}">
                                            <local:Icon Data="{StaticResource Ico.Trash}" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Εδώ ανοίγουν τα παράθυρα μέσα στην εφαρμογή (μηνύματα, Αναφορές, Ενεργοποίηση…). Βλ. Dialogs/InAppDialog.cs -->
        <Grid x:Name="dialogHost" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
