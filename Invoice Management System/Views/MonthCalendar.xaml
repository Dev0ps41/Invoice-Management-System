<UserControl x:Class="Invoice_Management_System.MonthCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Invoice_Management_System"
             xmlns:l="clr-namespace:Invoice_Management_System.Localization">
    <UserControl.Resources>
        <!-- Κουμπί ημέρας: η εμφάνιση (σήμερα / με καταχωρίσεις / άλλος μήνας) ορίζεται από τον κώδικα -->
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="Transparent"/>
                            <Border x:Name="hover" CornerRadius="10" Background="#0B1220" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.06"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="btnPrev" DockPanel.Dock="Left" Style="{StaticResource BtnIcon}" Width="40" Height="40" Click="Prev_Click">
                <local:Icon Data="{StaticResource Ico.ChevronLeft}" Width="16" Height="16" StrokeWidth="2.2"/>
            </Button>
            <Button x:Name="btnNext" DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" Width="40" Height="40" Click="Next_Click">
                <local:Icon Data="{StaticResource Ico.ChevronRight}" Width="16" Height="16" StrokeWidth="2.2"/>
            </Button>
            <TextBlock x:Name="txtMonth" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DockPanel>

        <UniformGrid x:Name="weekdays" Columns="7" Margin="0,0,0,2"/>
        <UniformGrid x:Name="days" Columns="7"/>

        <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
            <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{l:Tr Cal_Marked}" FontSize="13" Foreground="{StaticResource Ink2}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
