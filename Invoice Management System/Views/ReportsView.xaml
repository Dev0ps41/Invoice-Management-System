<UserControl x:Class="Invoice_Management_System.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Invoice_Management_System.Localization">
    <!-- Αναφορές: ανοίγει μέσα στο κύριο παράθυρο μέσω InAppDialog.ShowCustom -->
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <DockPanel>
            <!-- Επικεφαλίδες -->
            <Grid DockPanel.Dock="Top" Background="{StaticResource Subtle}" Height="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Rep_Supplier}" Margin="18,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink3}"/>
                <TextBlock Grid.Column="1" Text="{l:Tr Rep_Product}" Margin="16,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink3}"/>
                <TextBlock Grid.Column="2" Text="{l:Tr Rep_Total}" Margin="18,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink3}"/>
            </Grid>

            <!-- Γενικό σύνολο -->
            <Grid DockPanel.Dock="Bottom" Background="{StaticResource Ink}" Height="48">
                <TextBlock Text="{l:Tr Rep_GrandTotal}" Margin="18,0" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <TextBlock x:Name="txtGrandTotal" Margin="18,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="White" FontSize="16" FontWeight="ExtraBold" Typography.NumeralAlignment="Tabular"/>
            </Grid>

            <TextBlock x:Name="txtEmpty" DockPanel.Dock="Top" Text="{l:Tr Rep_Empty}" Margin="18,24" Foreground="{StaticResource Ink2}" Visibility="Collapsed"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <ItemsControl x:Name="rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" MinHeight="44">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Supplier}" Margin="18,0" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product}" Margin="16,0" VerticalAlignment="Center"
                                               FontWeight="{Binding ProductWeight}" Foreground="{Binding ProductBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Total}" Margin="18,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               FontWeight="{Binding TotalWeight}" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
