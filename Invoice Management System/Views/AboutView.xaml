<UserControl x:Class="Invoice_Management_System.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Invoice_Management_System.Localization">
    <!-- «Σχετικά με». Ανοίγει μέσα στο κύριο παράθυρο μέσω InAppDialog.ShowCustom -->
    <StackPanel>
        <Border Background="{StaticResource Subtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{l:Tr About_Developer}" Foreground="{StaticResource Ink3}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Netronium" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Text="{l:Tr About_Email}" Foreground="{StaticResource Ink3}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <Hyperlink NavigateUri="mailto:info@netronium.ch" RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource AccentInk}" TextDecorations="{x:Null}" FontWeight="SemiBold">info@netronium.ch</Hyperlink>
                </TextBlock>

                <TextBlock Grid.Row="2" Text="{l:Tr About_Files}" Foreground="{StaticResource Ink3}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{l:Tr About_FilesValue}" FontWeight="Medium" Margin="0,10,0,0"/>

                <TextBlock Grid.Row="3" Text="{l:Tr About_Storage}" Foreground="{StaticResource Ink3}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{l:Tr About_StorageValue}" FontWeight="Medium" Margin="0,10,0,0"/>

                <TextBlock Grid.Row="4" Text="{l:Tr About_DataFolder}" Foreground="{StaticResource Ink3}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtDataFolder" FontSize="12.5" Foreground="{StaticResource Ink2}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>
        <Button x:Name="okButton" Style="{StaticResource BtnDark}" Content="OK" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
</UserControl>
